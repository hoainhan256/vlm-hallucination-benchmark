import json
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.metrics import (
    accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    confusion_matrix
)

# Đọc kết quả benchmark
df = pd.read_csv(
    "/kaggle/working/pope_smollvm2_checkpoint.csv"
)

# Chỉ lấy các mẫu có kết quả hợp lệ
df = df[
    (df["status"] == "success") &
    (df["ground_truth"].str.lower().isin(["yes", "no"])) &
    (df["prediction"].str.lower().isin(["yes", "no"]))
].copy()

y_true = df["ground_truth"].str.lower()
y_pred = df["prediction"].str.lower()

# Tính các chỉ số đánh giá
metrics = {
    "total_evaluated": len(df),
    "accuracy": accuracy_score(y_true, y_pred),
    "precision": precision_score(
        y_true, y_pred, pos_label="yes", zero_division=0
    ),
    "recall": recall_score(
        y_true, y_pred, pos_label="yes", zero_division=0
    ),
    "f1_score": f1_score(
        y_true, y_pred, pos_label="yes", zero_division=0
    )
}

# Lưu kết quả JSON
with open(
    "/kaggle/working/evaluation_summary.json",
    "w",
    encoding="utf-8"
) as f:
    json.dump(metrics, f, ensure_ascii=False, indent=4)

# Tạo ma trận nhầm lẫn
cm = confusion_matrix(
    y_true, y_pred, labels=["no", "yes"]
)

plt.figure(figsize=(6, 5))
sns.heatmap(
    cm,
    annot=True,
    fmt="d",
    cmap="Blues",
    xticklabels=["No", "Yes"],
    yticklabels=["No", "Yes"]
)

plt.xlabel("Predicted")
plt.ylabel("Ground Truth")
plt.title("SmolVLM2 - POPE Confusion Matrix")
plt.tight_layout()

plt.savefig(
    "/kaggle/working/confusion_matrix.png",
    dpi=300
)

plt.show()

print("Đã lưu kết quả đánh giá!")
print(metrics)
